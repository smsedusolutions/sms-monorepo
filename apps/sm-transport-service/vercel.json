{
    "version": 2,
    "ignoreCommand": "git diff HEAD^ HEAD --quiet -- .",
    "builds": [
        {
            "src": "index.js",
            "use": "@vercel/node"
        }
    ],
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.js"
        }
    ]
}